# Zcode2Api — example configuration (v3.1).
#
# Copy to `.env` and edit. Values that contain the marker "change-me" are
# PLACEHOLDERS: config.Load() refuses to start while a secret still holds one.
# Precedence: runtime settings (admin UI) > ENV > default.

# --- Secrets (required, each >= 16 characters) ---------------------------------
# Client keys for /v1/*, comma-separated. Every key must be >= 16 characters.
CLIENT_API_KEYS=change-me-client-key-at-least-16-chars
# Admin dashboard password, >= 16 characters.
ADMIN_PASSWORD=change-me-admin-password-min-16-chars
# Optional: encrypts the JWT accounts stored in SQLite at rest
# (AES-256-GCM, HKDF-SHA256). Changing it makes previously
# stored tokens unreadable.
SECRET_KEY=

# --- Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=3101

# --- Storage -------------------------------------------------------------------
DB_PATH=data/zcode2api.db

# --- Channel A: free JWT account pool (primary upstream) -----------------------
# Origin only: the gateway appends /api/v1/zcode-plan/anthropic/v1/messages
# itself. Authentication is per-account "Authorization: Bearer <JWT>" plus the
# ZCode source headers.
UPSTREAM_URL=https://zcode.z.ai
# ZCode client identity sent on channel A:
#   User-Agent: ZCode/<ZCODE_APP_VERSION>   X-Platform: <ZCODE_PLATFORM>
ZCODE_APP_VERSION=3.16.3
ZCODE_PLATFORM=darwin-x64

# --- Channel B: optional Z.AI API-key fallback ---------------------------------
# Used ONLY after every pool attempt failed and no usable account remains
# (POST {FALLBACK_URL}/api/anthropic/v1/messages with x-api-key).
# Empty FALLBACK_API_KEY = channel B disabled.
FALLBACK_URL=https://api.z.ai
FALLBACK_API_KEY=

# --- Daily claim of the free quota ----------------------------------------------
# Claims once a day for each ACTIVE account at CLAIM_TIME (GMT+8, HH:MM).
DAILY_CLAIM=true
CLAIM_TIME=00:05
# Random delay added on top of CLAIM_TIME to avoid a thundering herd.
CLAIM_JITTER=10m
# The EMBEDDED node captcha solver (internal/captcha/captcha_node, parity
# reference assets) handles claim captchas automatically when Node.js + npm
# are on PATH — the solver tree materializes under <DB_PATH dir>/captcha_node
# and its npm deps install on first use. CLAIM_SOLVER_URL is an alternative
# external solver (POST {"token": ...} -> {"verify_param": ...}); when set it
# takes precedence.
CLAIM_SOLVER_URL=
CLAIM_SOLVER_KEY=
# Entitlement id posted as {"plan_id": ...} on claim (the parity reference's
# claimPlan). Read the id from GET /billing/balance -> data.plans[].entitlements[]
# (e.g. zcode-v3-start-plan-wk-1120-1 for the weekly Start Plan).
CLAIM_PLAN_ID=
# true = also claim accounts currently marked EXHAUSTED.
CLAIM_EXHAUSTED=false

# --- Egress proxy ---------------------------------------------------------------
# Optional global proxy for accounts without their own assignment.
# Allowed schemes: http://, https://, socks5://
# Static network configuration: never rotated automatically on upstream
# rejection (a 3012 puts the account into RISK_COOLDOWN instead).
DEFAULT_PROXY_URL=

# --- Default model mapping targets ----------------------------------------------
# Upstream model names used only by "reset default mapping"; empty here on
# purpose. Model names are never hardcoded in the code.
DEFAULT_MODEL_OPUS=
DEFAULT_MODEL_SONNET=
DEFAULT_MODEL_HAIKU=

# --- Behavior -------------------------------------------------------------------
STRICT_MODELS=false
INFLIGHT_LIMIT=3
MAX_ATTEMPTS=3
ATTEMPT_DEADLINE=60s
FIRST_EVENT_TIMEOUT=90s
FIRST_EVENT_MAX_BYTES=65536
UPSTREAM_HEADER_TIMEOUT=120s
COOLING_DURATION=60s
RISK_COOLDOWN=6h
EXHAUSTED_FALLBACK=1h
FAIL_THRESHOLD=3
# Background quota refresh (minutes): the free billing call that keeps the
# selector's remaining-quota ordering fresh and confirms quota resets.
# 0 disables the background refresh.
QUOTA_REFRESH_MIN=10
AFFINITY_ENABLED=true
AFFINITY_TTL=30m
MAX_BODY_BYTES=20971520
# Comma-separated allowlist; empty = same-origin only.
CORS_ORIGINS=
LOG_LEVEL=info
