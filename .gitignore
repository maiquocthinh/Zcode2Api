# SQLite database directory (DB_PATH default).
data/

# Compiled binary (cmd/zcode2api), Windows and Unix outputs.
/zcode2api
*.exe
*.exe~

# Design docs and UI mockup reference — local only, not part of the release.
docs/
demo/

# Local build scratch output.
/build/

# Local secrets — never commit.
.env

# Local dev launcher: carries dev keys and machine-specific paths.
run-dev.ps1

# Web UI build output and dependencies (embedded via go:embed).
# Nothing in web/dist is tracked: run `npm run build` (root script) before
# `go build` — the binary embeds dist via web/embed.go.
web/dist/
web/node_modules/
